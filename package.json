{
  "name": "system-3-company",
  "version": "0.1.0",
  "private": true,
  "description": "A company of narrow AI agents that makes 60-second interactive lessons, run on the System 3 architecture.",
  "scripts": {
    "dev": "npm run editorial:account && npm run registry && next dev",
    "build": "npm run editorial:account && npm run registry && next build",
    "start": "next start",
    "typecheck": "npm run registry && tsc --noEmit",
    "registry": "node tools/company.mjs registry",
    "company": "node tools/company.mjs",
    "check": "node tools/company.mjs check && node tools/memory.mjs check && npm run test:personalization",
    "qa": "playwright test",
    "walkthrough": "node tools/walkthrough.mjs",
    "verify": "npm run test:deploy && npm run test:publish && npm run test:lifehacks && npm run test:books && npm run test:algorithms && npm run test:kit && npm run test:eval && npm run test:hq && npm run test:platform && npm run test:lesson-frames && npm run test:accounts && npm run test:dispatch && npm run test:mailbox && npm run test:memory && npm run test:metrics && npm run test:settings && npm run test:main-feed && npm run test:dims && npm run check && npm run typecheck && npm run build && npm run qa",
    "metrics": "node tools/metrics.mjs",
    "deploy": "node tools/deploy.mjs",
    "test:deploy": "node --test tests/deploy/*.test.mjs",
    "test:publish": "node --test tests/publish/*.test.mjs",
    "test:dispatch": "node --test tests/dispatch/*.test.mjs",
    "test:memory": "node --test tests/memory/*.test.mjs",
    "test:dispatch:slow": "S3_SLOW_TESTS=1 node --test tests/dispatch/*.test.mjs",
    "test:lifehacks": "node --import ./tests/lifehacks/register.mjs --test tests/lifehacks/*.test.mjs",
    "test:kit": "node --test src/kit/knots/test/*.test.mjs",
    "test:eval": "node --test tests/eval/*.test.mjs",
    "test:hq": "node --import ./tests/lifehacks/register.mjs --test tests/hq/*.test.mjs",
    "test:books": "node --import ./tests/lifehacks/register.mjs --test tests/books/*.test.mjs",
    "test:algorithms": "node --import ./tests/lifehacks/register.mjs --test tests/algorithms/*.test.mjs",
    "test:spike": "node --import ./tests/lifehacks/register.mjs --test tests/spike/*.test.mjs",
    "test:platform": "node --import ./tests/lifehacks/register.mjs --test tests/platform/*.test.mjs",
    "test:mailbox": "node --test tests/mailbox/*.test.mjs",
    "test:settings": "node --import ./tests/lifehacks/register.mjs --test tests/settings/*.test.mjs",
    "test:personalization": "node company/personalization/model/gate.mjs",
    "test:dims": "node --test tests/personalization/dims-index.test.mjs",
    "test:metrics": "node --test tests/metrics/*.test.mjs",
    "test:accounts": "node --import ./tests/lifehacks/register.mjs --test --test-concurrency=1 tests/accounts/*.test.mjs",
    "editorial:account": "node tools/build-editorial-profiles.mjs company/evaluation/rounds/2026-10-18-round-1 src/data/editorial-profiles.account.json",
    "test:main-feed": "node --import ./tests/lifehacks/register.mjs --test tests/main-feed/*.test.mjs",
    "test:history": "node --test tests/history/*.test.mjs",
    "test:lesson-frames": "node --import ./tests/lifehacks/register.mjs --test tests/lesson-frames/*.test.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.10",
    "d3-geo": "^3.1.1",
    "next": "^16.4.3",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "22.18.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/topojson-client": "^3.1.5",
    "typescript": "5.9.2",
    "vercel": "63.1.2",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
