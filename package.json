{
  "name": "system-3-company",
  "version": "0.1.0",
  "private": true,
  "description": "A company of narrow AI agents that makes 60-second interactive lessons, run on the System 3 architecture.",
  "scripts": {
    "dev": "npm run registry && next dev",
    "build": "npm run registry && next build",
    "start": "next start",
    "typecheck": "npm run registry && tsc --noEmit",
    "registry": "node tools/company.mjs registry",
    "company": "node tools/company.mjs",
    "check": "node tools/company.mjs check",
    "qa": "playwright test",
    "walkthrough": "node tools/walkthrough.mjs",
    "verify": "npm run test:deploy && npm run test:lifehacks && npm run test:kit && npm run check && npm run typecheck && npm run build && npm run qa",
    "metrics": "node tools/metrics.mjs",
    "deploy": "node tools/deploy.mjs",
    "test:deploy": "node --test tests/deploy/*.test.mjs",
    "test:lifehacks": "node --import ./tests/lifehacks/register.mjs --test tests/lifehacks/*.test.mjs",
    "test:kit": "node --test src/kit/knots/test/*.test.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "22.18.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/topojson-client": "^3.1.5",
    "typescript": "5.9.2",
    "vercel": "63.1.2",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
