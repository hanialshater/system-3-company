+// package.json wiring for the external assessment 2026-10-17 follow-ups (tier 2: package.json; readiness record
+// company/engineering/readiness/2026-10-17-assessment-verify-scripts.md). `npm run verify` runs the rituals suite and
+// prints the ledger check summary as an informational step; `npm run check` (protected CI) is unchanged.
+// Run: npm run test:dispatch
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
+const scripts = JSON.parse(fs.readFileSync(path.join(ROOT, "package.json"), "utf8")).scripts;
+
+test("verify runs test:rituals and the informational ledger:info step; check does not include the ledger", () => {
+  assert.equal(scripts["ledger:info"], "node tools/ledger.mjs check --summary", "--summary always exits 0 (tests/dispatch/hard-budget.test.mjs)");
+  assert.equal(scripts["test:rituals"], "node --test tests/rituals/*.test.mjs");
+  assert.match(scripts.verify, /npm run test:rituals && npm run ledger:info && npm run check && /);
+  assert.doesNotMatch(scripts.check, /ledger/, "npm run check (protected CI) is unchanged");
+});
