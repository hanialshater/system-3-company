+// enforces them with its own MAX_AGENTS / MAX_BUILDERS constants; tests/org/generate.test.mjs fails
+// if those constants, the generated onboarding docs or the operating loop's active cap line disagree with this file.
+// Changing a number here needs a new decision record first (it is every session's rule).
+
+export const CAPS = {
+  agents: 14, // every kind of run in flight
+  builders: 3, // build or wave runs, and any run that performs a production build (addendum below)
+  decision: "company/decisions/2026-10-16-founder-agent-cap-14.md",
+  // Addendum in the same record (2026-10-16 ~11:30Z and ~12:30Z): a run that does a production build counts
+  // against the builder cap; QA, fact-check and learner runs on the shared review server do not.
