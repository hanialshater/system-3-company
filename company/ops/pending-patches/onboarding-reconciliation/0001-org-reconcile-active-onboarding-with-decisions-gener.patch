diff --git a/tests/org/generate.test.mjs b/tests/org/generate.test.mjs
new file mode 100644
index 000000000..c16501ab9
--- /dev/null
+++ b/tests/org/generate.test.mjs
@@ -0,0 +1,71 @@
+// Drift guard for the org generator (external assessment 2026-10-17, finding 6;
+// company/decisions/2026-10-17-onboarding-reconciliation.md). Fails when a generated file, a generated
+// count, or a cap number in active onboarding disagrees with tools/org data. Fix: edit the data, then
+// `node tools/org/generate.mjs`.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { render, drift, orgCounts, COUNT_DOCS } from "../../tools/org/generate.mjs";
+import { roles } from "../../tools/org/roles.mjs";
+import { CAPS, MODEL_DEFAULTS } from "../../tools/org/caps.mjs";
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
+const read = (rel) => fs.readFileSync(path.join(ROOT, rel), "utf8");
+
+test("every generated file on disk matches render() from tools/org data", () => {
+  const d = drift(ROOT);
+  assert.deepEqual(d, [], `drifted (run node tools/org/generate.mjs): ${d.join(", ")}`);
+});
+
+test("render() covers every role's onboarding doc and every non-human role's agent", () => {
+  const files = render(ROOT);
+  for (const r of roles) {
+    assert.ok(files[`company/roles/${r.id}.md`], `no onboarding doc for ${r.id}`);
+    if (!r.human) assert.ok(files[`.claude/agents/${r.id}.md`], `no agent for ${r.id}`);
+  }
+});
+
+test("hand-written docs carry the generated role count, not a typed number", () => {
+  const { roles: n } = orgCounts();
+  for (const rel of COUNT_DOCS) {
+    const t = read(rel);
+    assert.match(t, /<!-- GENERATED:org-count -->/, `${rel} has no org-count marker`);
+    assert.ok(t.includes(`<!-- GENERATED:org-count -->${n} roles`), `${rel} count is not ${n}`);
+    // A typed "<N> roles" outside the marker is the drift the assessment found ("26 roles").
+    const outside = t.replace(/<!-- GENERATED:org-count -->[\s\S]*?<!-- \/GENERATED:org-count -->/g, "");
+    assert.doesNotMatch(outside, /\b\d+ (narrow )?roles\b/, `${rel} has a hand-typed role count`);
+  }
+});
+
+test("dispatch-check enforces the caps in tools/org/caps.mjs", () => {
+  const src = read("tools/dispatch-check.mjs");
+  const agents = Number(src.match(/MAX_AGENTS\s*=\s*(\d+)/)?.[1]);
+  const builders = Number(src.match(/MAX_BUILDERS\s*=\s*(\d+)/)?.[1]);
+  assert.equal(agents, CAPS.agents, "MAX_AGENTS in tools/dispatch-check.mjs differs from tools/org/caps.mjs");
+  assert.equal(builders, CAPS.builders, "MAX_BUILDERS in tools/dispatch-check.mjs differs from tools/org/caps.mjs");
+  assert.ok(fs.existsSync(path.join(ROOT, CAPS.decision)), `cap decision ${CAPS.decision} is missing`);
+});
+
+test("the operating loop's active cap rule states the same caps", () => {
+  const loop = read("company/ops/operating-loop.md");
+  const c1 = loop.split("\n").find((l) => /^1\. At most \*\*\d+ agents\*\*/.test(l));
+  assert.ok(c1, "operating-loop.md has no 'Operating rules' C1 cap line");
+  assert.ok(c1.includes(`**${CAPS.agents} agents**`) && c1.includes(`**${CAPS.builders} builders**`), `C1 says: ${c1}`);
+  const blocks = loop.split("\n").find((l) => l.includes("(C1)"));
+  assert.ok(blocks?.includes(`any dispatch at ${CAPS.agents} in flight (C1)`), "the dispatch-blocking rule names a different agent cap");
+});
+
+test("the builder agent's model follows the recorded default", () => {
+  assert.ok(fs.existsSync(path.join(ROOT, MODEL_DEFAULTS.decision)));
+  assert.match(read(".claude/agents/demo-builder.md"), new RegExp(`^model: ${MODEL_DEFAULTS.builder}$`, "m"));
+});
+
+test("the working agreement does not tell dispatched roles to write the single-writer files", () => {
+  const doc = render(ROOT)["company/roles/demo-builder.md"];
+  const wa = doc.slice(doc.indexOf("## Working agreement"));
+  assert.doesNotMatch(wa, /board add/, "working agreement still tells every role to run board add");
+  assert.doesNotMatch(wa, /End every session by adding a dated entry to `company\/ops\/progress.md`/);
+  assert.match(wa, /Only the chief of staff writes/);
+});
diff --git a/tools/org/caps.mjs b/tools/org/caps.mjs
new file mode 100644
index 000000000..059c41b6e
--- /dev/null
+++ b/tools/org/caps.mjs
