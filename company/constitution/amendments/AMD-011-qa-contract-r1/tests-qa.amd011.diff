+
+/**
+ * AMD-011 part 3 (W-1264): the feed specs' pool, never cut by QA_ONLY. `published` is listed in every deployment;
+ * `listed` adds review (shown unless SHOW_REVIEW=off, src/lib/visibility.ts). Sorted, so the pick is stable.
+ */
+export function feedLessons(): { published: LessonRef[]; listed: LessonRef[] } {
+  const out = onDisk().sort((a, b) => a.slug.localeCompare(b.slug));
+  return { published: out.filter((l) => l.status === "published"), listed: out.filter((l) => l.status === "published" || l.status === "review") };
+}
