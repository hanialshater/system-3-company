#!/bin/sh
# Benchmark 8: the one way every arm and the hidden runner run Clojure.
#   clj-run [clojure.main args...]      e.g.  clj-run -m ccc.main in.c -o out.s
# Classpath: Clojure 1.12.6 + spec.alpha 0.5.238 + core.specs.alpha 0.4.74, then ./src of the current directory
# (run it from your compiler's directory). No other jars, no AOT classes, no network.
LIB="$(dirname "$(readlink -f "$0")")/lib"
unset JAVA_TOOL_OPTIONS JDK_JAVA_OPTIONS _JAVA_OPTIONS CLASSPATH
exec java -Xss64m -Xmx2g -XX:+UseSerialGC \
  -cp "$LIB/clojure-1.12.6.jar:$LIB/spec.alpha-0.5.238.jar:$LIB/core.specs.alpha-0.4.74.jar:src" \
  clojure.main "$@"
