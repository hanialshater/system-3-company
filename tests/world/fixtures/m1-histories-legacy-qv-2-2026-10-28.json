 "written_from": "company/product/2026-10-28-world-brief.md section 10a, rulings 4 and 5 (head-of-product, commit 0ed988c4e), with sections 3.2 and 10. No M1 code was read; none exists.",
 "rulings": {
  "4": "A counted legacy account row is not rewritten on sync. Stored rows, the browser's store and the export keep source and qv null; the pinned version is applied only when the state is derived.",
  "5": "Pre-M1 is judged by the record's at_ms, not its arrival. A null-source, null-qv record with at_ms at or after m1_release_at_ms is no evidence: it makes nothing Understood and sets no cue, but is kept and synced. A record with at_ms before release follows the legacy rule even if it syncs later."
 },
 "frozen": "Same terms as the earlier files: committed before the M1 maker's first commit under src/; a correction goes in a newer dated file.",
 "how_to_read": {
  "same_as": "m1-histories.json and m1-histories-legacy-qv-2026-10-28.json how_to_read.",
  "late_arrival": "A recall event with at_ms earlier than the step's now_ms arrives at now_ms. In these rows it may be dated before or at m1_release_at_ms and arrive after it. An event with a device is first held by that device alone, until a sync.",
  "stored_records": "expect.stored_records maps a device to the recall records it stores after the step, ordered by at_ms, each {lesson, at_ms, correct, source, qv}. Reveals are not listed. A legacy row's source and qv must be null.",
  "export": "expect.export maps a device to the recall records an export shows; same shape as stored_records."
 },
 "readings_chosen": [
  "Row legacy-qv-late-record-is-judged-by-its-own-time-for-condition-2 combines ruling 5 with 10a ruling 2: a late record's time, not its arrival, decides whether a question change came between it and M1. 10a says condition 2 is read from the record's time; if head-of-product reads it otherwise, only that row changes.",
  "Reveals made by old clients are not covered by ruling 5; these rows keep every reveal before release."
 ],
